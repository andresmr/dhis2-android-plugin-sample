{
  "$schema": "tools/plugin.schema.json",
  "name": "My DHIS2 plugin",
  "slug": "dhis2-android-plugin-template",
  "pluginId": "org.dhis2.mobile.plugin.template",
  "package": "org.dhis2.mobile.plugin.template",
  "entryPoint": "MyPlugin",
  "version": "0.1.0",
  "injectionPoints": ["DATA_SET_INSTANCE_CONTENT"],
  "slotConfig": {
    "DATA_SET_INSTANCE_CONTENT": {
      "dataSetUids": ["BfMAe6Itzgt"]
    }
  },
  "conventions": {
    "sdkAllowed": [
      "plugin/src/androidMain/kotlin/{packagePath}/data/**/*.kt"
    ],
    "repositoryInterfaces": [
      "plugin/src/commonMain/kotlin/{packagePath}/repository/*.kt"
    ]
  },
  "template": {
    "source": "dhis2/dhis2-android-plugin-sample",
    "formatVersion": 1,
    "initialised": false
  }
}
