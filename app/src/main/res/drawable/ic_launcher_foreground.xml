        android:scaleX="0.69"
        android:scaleY="0.6876125"
        android:translateX="44.795"
        android:translateY="44.983807">

        <!-- The added layer. Solid, and in the band colour, so it separates from the white stack
             at every size and still reads when the gap between them closes. -->
        <path
            android:fillColor="#045D84"
            android:pathData="M144.5,32L206.5,56L144.5,80L82.5,56Z" />

