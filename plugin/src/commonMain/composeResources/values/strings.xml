<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every string the plugin shows. Keeping them here rather than in the Composable is what makes
         values-es/ possible at all — cheap to keep from day one, expensive to retrofit once a
         string has been hardcoded. -->
    <string name="plugin_title">Stock Management</string>
    <string name="plugin_loading">Loading…</string>
    <string name="plugin_error_prefix">Could not read from DHIS2:</string>

    <!-- The period of the instance the host opened. The state carries it structured — Month(2024, 1)
         — precisely so these can be translated; a period formatted into a String by the ViewModel
         could never reach values-es/, because month names live here.
         Compose Multiplatform substitutes positional %N$s placeholders; a bare %d is left alone. -->
    <string name="period_day">%1$s %2$s %3$s</string>
    <string name="period_week">Week %1$s, %2$s</string>
    <string name="period_month">%1$s %2$s</string>
    <string name="period_quarter">Q%1$s %2$s</string>

    <string name="month_1">January</string>
    <string name="month_2">February</string>
    <string name="month_3">March</string>
    <string name="month_4">April</string>
    <string name="month_5">May</string>
    <string name="month_6">June</string>
    <string name="month_7">July</string>
    <string name="month_8">August</string>
    <string name="month_9">September</string>
    <string name="month_10">October</string>
    <string name="month_11">November</string>
    <string name="month_12">December</string>
</resources>
