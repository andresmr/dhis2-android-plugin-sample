<!--
  The plugin mark: a layer added to the DHIS2 stack.

  Derived from the Capture App's own layered glyph, which is what this plugin renders beside. The
  top layer is solid and the host's layer is an outline, because a plugin IS an extra layer — one
  the app did not ship with, slotted in above the programme list.

  Drawn at 24dp, the size it is actually used at, rather than shrunk from a launcher icon. That is
  why it is two shapes and not five: at this size a gap survives and a detail does not. Filled
  against stroked carries the meaning even when the gap closes on a low-density screen.

  Shared with the seed in plugin/ on purpose: both are DHIS2's own, and an example that invented a
  second mark would suggest the mark is the plugin's to choose. A real third-party plugin replaces
  this with its own.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The plugin: solid, detached, above. -->
    <path
        android:fillColor="#045D84"
        android:pathData="M12,1.8L18.6,5.6L12,9.4L5.4,5.6Z" />

    <!-- The host's stack: an outline, so the two never merge into one blob. -->
    <path
        android:strokeColor="#045D84"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:pathData="M12,12L20.8,17L12,22L3.2,17Z" />
</vector>
